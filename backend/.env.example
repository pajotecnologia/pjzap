NODE_ENV=
BACKEND_URL=http://localhost
FRONTEND_URL=http://localhost:3000
PROXY_PORT=8080
PORT=8080

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASS=senha
DB_NAME=db_name

# OBRIGATORIOS. Gere valores unicos por instalacao, nunca reaproveite os de outro
# ambiente. O backend nao inicia com segredo vazio, curto (< 32) ou de exemplo:
#   openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Origens liberadas para chamadas do navegador com credenciais (separadas por virgula).
# Se ficar vazio, usa FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# Quantidade de proxies reversos na frente da aplicacao (nginx local = 1). Usado para
# descobrir o IP real do cliente no rate limit. Se houver CDN/load balancer extra,
# aumente; um valor alto demais permite forjar o IP via X-Forwarded-For.
TRUST_PROXY_HOPS=1

REDIS_URI=redis://:123456@127.0.0.1:6379
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true

GERENCIANET_SANDBOX=false
GERENCIANET_CLIENT_ID=Client_Id_Gerencianet
GERENCIANET_CLIENT_SECRET=Client_Secret_Gerencianet
GERENCIANET_PIX_CERT=certificado-Gerencianet
GERENCIANET_PIX_KEY=chave pix gerencianet

COMPANY_NAME=Whaticket

MAIL_HOST="smtp.hostinger.com"
MAIL_USER="contato@seusite.com"
MAIL_PASS="senha"
MAIL_FROM="Recuperar Senha <contato@seusite.com>"
MAIL_PORT="465"
